<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing from Commit is copied to cloud backup or to a new
     device. A restored copy could bring back an old challenge or an old
     payment state. Once a backend exists, a new install gets its state from
     the server instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
